model Refund {
  refund_id Int          @id @default(autoincrement())
  order_id  Int
  order     Order        @relation(fields: [order_id], references: [order_id])
  status    RefundStatus
  amount    Float
  createdAt DateTime     @default(now())
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}
